{
  "include": ["src"],
  "compilerOptions": {
    "types": ["vitest/globals", "node"],
    "outDir": "dist",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "declaration": true,
    "declarationDir": "dist",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "jsx": "react",
    "newLine": "lf",
    "skipLibCheck": true,
    "paths": {
      "~/*": ["./src/*"]
    }
  }
}
